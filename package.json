{
  "name": "intelera-pro",
  "private": true,
  "description": "Intelera — Cybersecurity & Secure Web Engineering",
  "scripts": {
    "dev": "concurrently -n f,b -c cyan,magenta \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "start:backend": "cd backend && npm start",
    "pentest:api": "cd ai-pentest-platform && python run.py",
    "pentest:install": "cd ai-pentest-platform && pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
