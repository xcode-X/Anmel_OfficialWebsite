PORT=5000
CLIENT_URL=http://localhost:5173

# ── Firebase (required — replaces MongoDB Atlas) ─────────────────────────────
# Path to service account JSON from Firebase Console → Project settings → Service accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Web API key (Project settings → General) — used for admin email/password login on the API
FIREBASE_WEB_API_KEY=
# Optional inline credentials instead of JSON file:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Optional: student activation links (legacy JWT)
JWT_SECRET=your-secret-key-change-in-production
ADMIN_EMAIL=admin@intelera.com
ADMIN_PASSWORD=admin123
# Must match auth.js defaults if unset (demo.admin@anmelinc.com)
DEMO_ADMIN_EMAIL=demo.admin@anmelinc.com
DEMO_ADMIN_PASSWORD=DemoAdmin@123
STUDENT_PORTAL_URL=http://localhost:5173/student
# Required for LMS login emails to students (e.g. Gmail: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@intelera.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPENAI_API_KEY=
OPENAI_SECURITY_MODEL=gpt-4o-mini

# Optional: auto-post scholarships to Facebook & LinkedIn (otherwise share dialogs open in browser)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# Intelera AI Python pentest platform (FastAPI). Start with: npm run pentest:api
# Must match API_KEYS in ai-pentest-platform/.env
PENTEST_PLATFORM_URL=http://localhost:8080
PENTEST_PLATFORM_API_KEY=intelera-dev-pentest-key
# When true (default), Intelera AI Python is the primary pentest engine; Node only does reachability + transport.
# Set to false to use the legacy full Node scan first, with Python as a supplement.
INTELERA_AI_PRIMARY=true
# Optional: full CrewAI phases (slow). Default is light tool path.
PENTEST_INTELERA_FULL_CREW=false
PENTEST_SYNC_MAX_TICKS=48
PENTEST_SYNC_TIMEOUT_SEC=280

# ── File storage ──────────────────────────────────────────────────────────────
# Driver: local (disk) or s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
UPLOAD_DIR=
PUBLIC_BASE_URL=http://localhost:5000
UPLOAD_MAX_BYTES=12582912
# Optional: also save a local copy when using S3 (backup / migration)
# STORAGE_LOCAL_MIRROR=true

# ── S3 / Cloudflare R2 (when STORAGE_DRIVER=s3) ─────────────────────────────
# S3_BUCKET=anmel-uploads
# S3_REGION=auto
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public URL for files (R2 r2.dev URL or custom CDN domain — see docs/CLOUDFLARE-R2-CDN.md)
# S3_PUBLIC_URL_BASE=https://cdn.anmel.com
# S3_FORCE_PATH_STYLE=true
# S3_CACHE_CONTROL=public, max-age=604800, immutable

# ── Production ────────────────────────────────────────────────────────────────
# NODE_ENV=production
# Serve built frontend from backend (after: cd frontend && npm run build)
# SERVE_FRONTEND=true
# FRONTEND_DIST=../../frontend/dist

# Max concurrent security scans (default 2)
SCAN_QUEUE_CONCURRENCY=2
